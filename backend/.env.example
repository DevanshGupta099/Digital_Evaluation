# Storage / DB
DATABASE_URL=sqlite:///./grader.db
STORAGE_DIR=./storage

# OCR provider: mock | azure | google | gemini
OCR_PROVIDER=gemini
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# ──────────────────────────────────────────────────────────
# Stage 4 — Dual-pass grading (two independent LLMs)
# ──────────────────────────────────────────────────────────

# Pass 1 (primary grader): Google Gemini
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Pass 2 (independent cross-check): Groq
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Shared grading parameters
GRADING_TEMPERATURE=0.0
GRADING_PASSES=2
DISAGREEMENT_THRESHOLD=0.15
CONFIDENCE_THRESHOLD=0.75
OCR_CONFIDENCE_THRESHOLD=0.60

# Rendering
RENDER_DPI=300
